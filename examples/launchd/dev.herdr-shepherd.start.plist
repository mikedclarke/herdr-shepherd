<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Starts the shepherd daemon in a herdr-core terminal at login and checks on it
  every five minutes. `herdr-shepherd start` does nothing while the daemon runs,
  so the repeat only matters after the daemon or the core went away.

  Replace the two placeholder paths, then:
    cp dev.herdr-shepherd.start.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.herdr-shepherd.start.plist

  The backend comes from config.toml (backend = "core"), which every other
  herdr-shepherd command reads too.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.herdr-shepherd.start</string>
	<key>ProgramArguments</key>
	<array>
		<string>/path/to/herdr-shepherd</string>
		<string>start</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>StandardOutPath</key>
	<string>/path/to/home/.local/state/herdr-shepherd/start.log</string>
	<key>StandardErrorPath</key>
	<string>/path/to/home/.local/state/herdr-shepherd/start.log</string>
</dict>
</plist>
